rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function permanentUser() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update, delete: if owner(uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if permanentUser()
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if permanentUser()
        && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if permanentUser()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if permanentUser()
          && resource.data.uid == request.auth.uid;
      }
    }

    match /users/{uid}/{document=**} {
      allow read, write: if owner(uid);
    }

    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
