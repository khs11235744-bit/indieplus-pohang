rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function textOk(v, max) { return v is string && v.size() > 0 && v.size() <= max; }

    match /profiles/{uid} {
      allow read: if true;
      allow create, update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() <= 24;
      allow delete: if owner(uid);
    }

    match /posts/{postId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 24
        && textOk(request.resource.data.body, 5000);
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid
          && textOk(request.resource.data.text, 1000);
        allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      match /likes/{uid} {
        allow read: if true;
        allow create, update: if owner(uid) && request.resource.data.uid == uid;
        allow delete: if owner(uid);
      }
    }

    match /follows/{followId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.followerUid == request.auth.uid
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid != request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUid == request.auth.uid;
      allow update: if false;
    }

    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.targetType == 'post'
        && request.resource.data.targetId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() <= 40
        && request.resource.data.memo is string
        && request.resource.data.memo.size() <= 500;
      allow read, delete: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow update: if false;
    }

    match /users/{uid}/notifications/{notificationId} {
      allow read, update, delete: if owner(uid);
      allow create: if signedIn()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.targetUid == uid
        && request.resource.data.type in ['follow','like','comment']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 180;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if owner(uid);
    }

    match /public/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
